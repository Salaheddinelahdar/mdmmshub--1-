{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Public student profile displayed on the leaderboard and profile pages (no PII).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 120000
        },
        "role": {
          "type": "string",
          "enum": ["student"]
        },
        "approved": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "photoUrl", "role", "approved", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII record containing user email isolated from public leaderboard queries.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "PointLog": {
      "title": "PointLog",
      "description": "Transparent public record of a point addition or penalty for a student.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "points": {
          "type": "number"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "studentId", "seasonId", "action", "points", "note", "createdAt"]
    },
    "Season": {
      "title": "Season",
      "description": "Academic semester or competition season.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "startDate": {
          "type": "string",
          "maxLength": 32
        },
        "endDate": {
          "type": "string",
          "maxLength": 32
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "startDate", "endDate", "active", "createdAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Course exam belonging to an academic season.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "seasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "seasonId", "createdAt"]
    },
    "ExamScore": {
      "title": "ExamScore",
      "description": "Recorded exam grade for a student and points awarded.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "score": {
          "type": "number"
        },
        "pointsAwarded": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "studentId", "examId", "seasonId", "score", "pointsAwarded", "createdAt"]
    },
    "HallOfFameEntry": {
      "title": "HallOfFameEntry",
      "description": "Archived top 3 podium entry for a completed season.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 120000
        },
        "rank": {
          "type": "number"
        },
        "totalPoints": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "seasonId", "seasonName", "studentId", "studentName", "photoUrl", "rank", "totalPoints", "createdAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Public student leaderboard profiles (approved profiles readable by public)."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private PII emails isolated to document owner and admins."
    },
    "/point_logs/{logId}": {
      "schema": { "$ref": "#/entities/PointLog" },
      "description": "Publicly readable point log entries writable only by admins."
    },
    "/seasons/{seasonId}": {
      "schema": { "$ref": "#/entities/Season" },
      "description": "Academic seasons/semesters."
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Exams associated with a season."
    },
    "/exam_scores/{scoreId}": {
      "schema": { "$ref": "#/entities/ExamScore" },
      "description": "Student exam scores."
    },
    "/hall_of_fame/{entryId}": {
      "schema": { "$ref": "#/entities/HallOfFameEntry" },
      "description": "All-time top 3 podium winners per archived season."
    }
  }
}
